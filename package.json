{
  "name": "chess-rule-engine",
  "version": "0.1.1",
  "description": "A TypeScript chess rules engine for legal move validation and game-state management",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc watch src/index.ts"
  },
  "keywords": [
    "chess",
    "chess-rule-engine",
    "typescript"
  ],
  "license": "ISC",
  "devDependencies": {
    "madge": "^8.0.0",
    "typescript": "^7.0.2"
  }
}